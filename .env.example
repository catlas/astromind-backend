# Copy this file to `.env` and fill the values for local development.
# Do NOT commit your real `.env` (it may contain secrets).

# Ollama Cloud (Primary AI Provider)
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_API_KEY=your_ollama_api_key_here
OLLAMA_MODEL=qwen3.5:cloud

# Together.ai (Fallback AI Provider)
OPENAI_API_KEY=your_together_api_key_here
TOGETHER_API_URL=https://api.together.xyz/v1/chat/completions
TOGETHER_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507-tput

# JWT signing key used by auth.py
SECRET_KEY=

# Optional DB connection string. If empty, the app falls back to local SQLite (./astromind.db).
DATABASE_URL=
