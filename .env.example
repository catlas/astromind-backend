# Copy this file to `.env` and fill the values for local development.
# Do NOT commit your real `.env` (it may contain secrets).

# Ollama Cloud (Primary AI Provider)
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_API_KEY=your_ollama_api_key_here
OLLAMA_MODEL=deepseek-v4.1-flash:cloud

# Together.ai (Fallback AI Provider)
OPENAI_API_KEY=your_together_api_key_here
TOGETHER_API_URL=https://api.together.xyz/v1/chat/completions
TOGETHER_MODEL=deepseek-ai/DeepSeek-V4.1-Flash

# JWT signing key used by auth.py
SECRET_KEY=

# Optional DB connection string. If empty, the app falls back to local SQLite (./astromind.db).
DATABASE_URL=

# Лимити на заявките (по избор; тези са стойностите по подразбиране)
AI_RATE_LIMIT_PER_HOUR=20
AI_RATE_LIMIT_PER_DAY=60
DOCX_RATE_LIMIT_PER_HOUR=30
CALCULATE_RATE_LIMIT_PER_MINUTE=60
LOGIN_RATE_LIMIT_PER_15_MIN=10
REGISTER_RATE_LIMIT_PER_HOUR=5

# Имейли (потвърждение на имейл, забравена парола). Без тях писма не се изпращат.
FRONTEND_URL=https://astromind-web.onrender.com
# Подателят трябва да е адресът на самата пощенска кутия, иначе сървърът отказва писмата
MAIL_FROM=AstroMind <no-reply@your-domain.bg>
# Вариант 1: Resend (resend.com), по HTTPS
RESEND_API_KEY=
# Вариант 2: SMTP през собствена пощенска кутия.
# Порт 465 = защитена връзка от началото (ssl); портове 26 и 587 = STARTTLS.
# SMTP_SECURITY=ssl|starttls|none го задава изрично.
# ВНИМАНИЕ: Render Free блокира изходящи портове 25, 465 и 587. На безплатен план ползвайте
# друг порт на пощенския сървър (напр. 26, ако хостингът го предлага) или платен план.
# Пример: SMTP_HOST=mail.your-domain.bg  SMTP_USER=no-reply@your-domain.bg  (паролата - само в Render)
SMTP_HOST=
SMTP_PORT=26
SMTP_USER=
SMTP_PASSWORD=
# Сертификатът на сървъра се проверява. 0 изключва проверката (само при крайна нужда).
# SMTP_VERIFY_TLS=1
# Колко секунди да се чака пощенският сървър (по подразбиране 15)
# SMTP_TIMEOUT=15

# Плащания (Stripe). Без двата ключа плащанията са изключени, анализите са безплатни и нищо не е заключено.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Баланс в евро (вместо AstroМонетите). Дали услугите се плащат от баланса (по подразбиране: да, когато Stripe е включен)
# BALANCE_ENFORCED=1
# Цени в евроценти (стойностите по подразбиране). Основен анализ е анализът за един човек (натален или за дата).
# Премиум са анализът за двама и прогнозата за период: плащат се само с внесени средства, не с подаръка.
PRICE_BASIC_ANALYSIS_CENTS=160
PRICE_PAIR_ANALYSIS_CENTS=180
PRICE_FORECAST_MONTH_CENTS=75
PRICE_FORECAST_PARTNER_CENTS=60
# Подарък при регистрация (евроценти). Важи само за основните анализи; премиум услугите се отключват след зареждане
SIGNUP_GIFT_CENTS=500
# Пакети за зареждане (по избор), JSON: [{"id":"topup5","name":"5 €","amount_cents":500,"credit_cents":500}, ...]
# amount_cents е платената сума, credit_cents е кредитът в баланса (разликата е бонус).
# TOPUP_PACKAGES=
# Старите COST_ANALYSIS, COST_PARTNER_EXTRA, COST_FORECAST_MONTH, SIGNUP_BONUS_COINS и COIN_PACKAGES (в монети) вече не се четат.

# Задачи за анализ (Фаза 11): анализът върви на сървъра, а екранът го следи. Стойностите по подразбиране:
# JOB_DEADLINE_SECONDS=900          срок на цялата задача (секунди); след него тя се проваля и сумата се връща
# JOB_CONCURRENCY=3                 колко анализа генерират едновременно (останалите чакат ред)
# JOB_MAX_ACTIVE_PER_USER=2         най-много активни анализи на потребител
# JOB_MAX_ATTEMPTS=2                колко пъти се опитва задача, прекъсната от рестарт на сървъра
# JOB_RETENTION_DAYS=14             след колко дни приключилите задачи се трият (отчетите в История остават)
# JOB_CREATE_RATE_LIMIT_PER_10_MIN=60   опити за създаване на задача на потребител, включително невалидните

# Админ достъп до /admin/metrics (имейлите трябва да са потвърдени)
ADMIN_EMAILS=

# Търсене на координати с AI (лимит на потребител)
GEOCODE_RATE_LIMIT_PER_HOUR=30
GEOCODE_RATE_LIMIT_PER_DAY=100

# --- Качество на анализите (Фаза 8) ---
# Температура на AI за текстовете с много факти. По-ниска = по-малко измислени домове и дати.
AI_TEMPERATURE=0.4
# Горна граница на периода на прогнозата (календарни месеци, включително първия и последния).
# Всеки месец е отделна AI заявка, затова периодът е ограничен.
FORECAST_MAX_MONTHS_SINGLE=3
FORECAST_MAX_MONTHS_PAIR=2

# --- Проверка на готовия текст (Фаза 10) ---
# Готовият анализ се сверява с изчислените факти (дом, знак, аспект, дата, час). При грешка се прави най-много една поправка;
# ако и след нея има грешка, анализът не се записва и не се таксува.
# enforce (по подразбиране) | warn (само записва в статистиката, нищо не поправя и не отхвърля) | off (само маха служебните етикети)
# Ако проверката започне да отхвърля верни текстове, веднага сложете warn в Render, без нов деплой.
# TEXT_CHECK_MODE=enforce
# Видове нарушения, които да се пренебрегват (по избор): house, sign, aspect, orb, exact, cusp, ruler, retro_count, date, time, event
# TEXT_CHECK_IGNORE=
