# Copy this file to `.env` and fill the values for local development.
# Do NOT commit your real `.env` (it may contain secrets).

# OpenAI API key used by the backend AI interpreter
OPENAI_API_KEY=

# JWT signing key used by auth.py
SECRET_KEY=

# Optional DB connection string. If empty, the app falls back to local SQLite (./astromind.db).
DATABASE_URL=
